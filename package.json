{
  "name": "pokemon-dmg-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gen 6 (XY/ORAS) Pokemon damage calculator + stat database",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "fetch:data": "node scripts/fetch-xy-dex.mjs",
    "gen:aux": "node scripts/gen-move-ability-data.mjs",
    "build": "tsc",
    "check": "npm run build && node dist/check.js",
    "verify:damage": "npm run build && node scripts/verify-smogon.mjs",
    "verify:acc": "npm run build && node scripts/verify-accuracy.mjs",
    "verify:echo": "node scripts/verify-echo.mjs",
    "verify:help": "node scripts/verify-help.mjs",
    "verify:lookup": "node scripts/verify-lookup.mjs",
    "verify:multihit": "npm run build && node scripts/verify-multihit.mjs",
    "damage": "node scripts/damage.mjs"
  },
  "devDependencies": {
    "@smogon/calc": "^0.11.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
